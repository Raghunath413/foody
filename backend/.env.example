PORT=3000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (database name: food_view)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food_view

# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me

# ImageKit dashboard -> Developer options
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
